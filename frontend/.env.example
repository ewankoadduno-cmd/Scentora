VITE_API_URL=http://127.0.0.1:3000/api

# For Vercel, set VITE_API_URL in the project's environment settings and redeploy.
# Use your public HTTPS backend address, including /api, without a trailing slash.
# Example: VITE_API_URL=https://your-api.example.com/api
# VITE_* values are public. Keep MongoDB credentials and JWT secrets on the backend.
