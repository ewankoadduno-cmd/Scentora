PORT=3000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/scentora

# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/scentora?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_secret

# Backend Vercel project: Root Directory = api.
# Set MONGO_URI to the Atlas URI and JWT_SECRET in Vercel Environment Variables.
# PORT is used locally; Vercel manages the deployed HTTP listener.
